{
    "configurations": [
        {
            "name": "ARM-none-eabi",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/User/Inc",
                "${workspaceFolder}/Audio/Inc",
                "${workspaceFolder}/core/Core/Include",
                "${workspaceFolder}/STM32_USB_Device_Library/Core/Inc",
                "${workspaceFolder}/STM32_USB_Device_Library/Class/AUDIO_10/Inc",
                "${workspaceFolder}/stm32f4xx-hal-driver/Inc",
                "/usr/lib/arm-none-eabi/include"
            ],
            "defines": [
                "STM32F446xx",
                "USE_USB_FS",
                "USE_USB_AUDIO_PLAYBACK"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}